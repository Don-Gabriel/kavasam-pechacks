KAVASAM_ENVIRONMENT=development
KAVASAM_SECRET_KEY=replace-with-a-long-random-value
KAVASAM_EXPOSE_DEV_OTP=true
KAVASAM_TOKEN_TTL_MINUTES=60
KAVASAM_RATE_LIMIT_PER_MINUTE=120
KAVASAM_CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Optional. When absent, the deterministic rule engine remains fully functional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

