{
  "name": "Kavasam Guardian",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kavasam-guardian",
        "responseMode": "lastNode",
        "options": {
          "responseCode": 202
        }
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Guardian Event In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-360, -120],
      "webhookId": "kavasam-guardian"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body.event }}",
        "rules": {
          "rules": [
            { "value2": "guardian_alert", "output": 0 },
            { "value2": "guardian_report", "output": 0 },
            { "value2": "guardian_approval", "output": 1 },
            { "value2": "guardian_enrollment", "output": 2 }
          ]
        },
        "fallbackOutput": 0
      },
      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "Route by event",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [-120, -120]
    },
    {
      "parameters": {
        "chatId": "={{ $json.body.to }}",
        "text": "=🛡️ Kavasam alert\n\n{{ $json.body.message }}",
        "additionalFields": {}
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Alert guardian (danger/report)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [180, -260],
      "notes": "Connect your Telegram bot credential. chatId = the guardian's Telegram chat id (the alertHandle they entered when linking)."
    },
    {
      "parameters": {
        "chatId": "={{ $json.body.to }}",
        "text": "=⚠️ Kavasam: approve or reject a suspicious call\n\n{{ $json.body.message }}\n\nReply here, then the Kavasam app updates.",
        "additionalFields": {}
      },
      "id": "d4444444-4444-4444-8444-444444444444",
      "name": "Ask guardian (approval)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [180, -120]
    },
    {
      "parameters": {
        "chatId": "={{ $json.body.to }}",
        "text": "=👋 Kavasam guardian invite\n\n{{ $json.body.message }}",
        "additionalFields": {}
      },
      "id": "e5555555-5555-4555-8555-555555555555",
      "name": "Invite guardian (enrollment)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [180, 20]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kavasam-reply",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "f6666666-6666-4666-8666-666666666666",
      "name": "Guardian Reply In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-360, 260],
      "webhookId": "kavasam-reply"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.body.replyWebhookUrl || 'https://YOUR-GATEWAY/v1/guardian/reply' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Kavasam-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"senderPhone\": $json.body.senderPhone, \"message\": $json.body.message } }}",
        "options": {}
      },
      "id": "07777777-7777-4777-8777-777777777777",
      "name": "Forward reply to Kavasam",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-120, 260],
      "notes": "Set N8N_WEBHOOK_SECRET in n8n env to match the gateway. The gateway parses ACCEPT/REJECT/JOIN + the 4-digit reference."
    }
  ],
  "connections": {
    "Guardian Event In": {
      "main": [[{ "node": "Route by event", "type": "main", "index": 0 }]]
    },
    "Route by event": {
      "main": [
        [{ "node": "Alert guardian (danger/report)", "type": "main", "index": 0 }],
        [{ "node": "Ask guardian (approval)", "type": "main", "index": 0 }],
        [{ "node": "Invite guardian (enrollment)", "type": "main", "index": 0 }]
      ]
    },
    "Guardian Reply In": {
      "main": [[{ "node": "Forward reply to Kavasam", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
