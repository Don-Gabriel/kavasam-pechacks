# Copy this file to cloud/.env for local development.
# cloud/.env is ignored by Git. Leave optional values blank until configured.

# Core Kavasam gateway
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
NUMBER_HMAC_SECRET=
KAVASAM_DB_PATH=data/kavasam.db

# Actian VectorAI DB — required online vector analytics layer.
# Use the REST endpoint (normally port 6573). Local development needs no token.
ACTIAN_VECTORAI_URL=
ACTIAN_VECTORAI_ACCESS_TOKEN=
ACTIAN_VECTORAI_COLLECTION=kavasam_scam_patterns
ACTIAN_VECTORAI_TIMEOUT_SECONDS=2.5
# Read Actian's EULA before setting this to YES for the Docker image.
ACTIAN_VECTORAI_ACCEPT_EULA=

# Public URLs
# PUBLIC_BASE_URL must be the deployed HTTPS gateway URL for guardian SMS callbacks.
PUBLIC_BASE_URL=
# Used as a Flutter --dart-define, not directly by the Python gateway.
KAVASAM_AI_BASE_URL=

# n8n guardian approval workflow
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Inventory only: configure one provider block in n8n Credentials.
# These values are not read directly by the Kavasam gateway.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=
MSG91_INBOUND_WEBHOOK_SECRET=

# MongoDB Atlas — optional future community-reputation scale-out, not the vector engine.
MONGODB_URI=
MONGODB_DATABASE=kavasam
MONGODB_REPUTATION_COLLECTION=caller_reputation
MONGODB_PATTERN_COLLECTION=scam_patterns
MONGODB_VECTOR_INDEX=scam_pattern_vector_index

# ElevenLabs multilingual warnings — planned integration.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_TA=

# Snowflake privacy-safe analytics — planned integration.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_B64=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# Inventory only: Render deployment automation; not read by the gateway.
RENDER_API_KEY=
RENDER_OWNER_ID=

# Inventory only: Vultr optional deployment; not read by the gateway yet.
VULTR_API_KEY=
VULTR_REGION=

# Inventory only: Solana evidence timestamping; not read by the gateway yet.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=
